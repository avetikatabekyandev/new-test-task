{"ast":null,"code":"import { ref } from 'vue';\nexport default {\n  __name: 'App',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const groups = ref([[{\n      id: 1,\n      label: 'Наименование'\n    }], [{\n      id: 2,\n      label: 'Количество'\n    }], [{\n      id: 3,\n      label: 'Артикул'\n    }]]);\n    const dragged = ref(null);\n    const fromGroupIndex = ref(null);\n    const hovered = ref({\n      groupIndex: null,\n      fieldIndex: null,\n      position: null // 'left' | 'right' | 'top' | 'bottom'\n    });\n    function onDragStart(field, groupIndex) {\n      dragged.value = field;\n      fromGroupIndex.value = groupIndex;\n    }\n    function onDragOver(event, groupIndex, fieldIndex) {\n      const rect = event.target.getBoundingClientRect();\n      const offsetX = event.clientX - rect.left;\n      const offsetY = event.clientY - rect.top;\n      let position = null;\n      if (offsetY < rect.height / 3) position = 'top';else if (offsetY > rect.height * 2 / 3) position = 'bottom';else if (offsetX < rect.width / 2) position = 'left';else position = 'right';\n      hovered.value = {\n        groupIndex,\n        fieldIndex,\n        position\n      };\n    }\n    function onDragLeave() {\n      hovered.value = {\n        groupIndex: null,\n        fieldIndex: null,\n        position: null\n      };\n    }\n    function onDrop() {\n      const {\n        groupIndex,\n        fieldIndex,\n        position\n      } = hovered.value;\n      if (!dragged.value || groupIndex === null || fieldIndex === null) return;\n      const field = dragged.value;\n      const sourceGroup = groups.value[fromGroupIndex.value];\n      sourceGroup.splice(sourceGroup.findIndex(f => f.id === field.id), 1);\n      if (sourceGroup.length === 0) {\n        groups.value.splice(fromGroupIndex.value, 1);\n      }\n      if (position === 'left' || position === 'right') {\n        const targetGroup = groups.value[groupIndex];\n        const insertIndex = position === 'left' ? fieldIndex : fieldIndex + 1;\n        targetGroup.splice(insertIndex, 0, field);\n      } else {\n        const newGroupIndex = position === 'top' ? groupIndex : groupIndex + 1;\n        groups.value.splice(newGroupIndex, 0, [field]);\n      }\n\n      // Reset\n      dragged.value = null;\n      fromGroupIndex.value = null;\n      hovered.value = {\n        groupIndex: null,\n        fieldIndex: null,\n        position: null\n      };\n    }\n    const __returned__ = {\n      groups,\n      dragged,\n      fromGroupIndex,\n      hovered,\n      onDragStart,\n      onDragOver,\n      onDragLeave,\n      onDrop,\n      ref\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","groups","id","label","dragged","fromGroupIndex","hovered","groupIndex","fieldIndex","position","onDragStart","field","value","onDragOver","event","rect","target","getBoundingClientRect","offsetX","clientX","left","offsetY","clientY","top","height","width","onDragLeave","onDrop","sourceGroup","splice","findIndex","f","length","targetGroup","insertIndex","newGroupIndex"],"sources":["/Users/avetikatabekyan/Desktop/new-test-task/src/App.vue"],"sourcesContent":["<template>\n  <div class=\"form-grid\">\n    <div\n        v-for=\"(group, gIndex) in groups\"\n        :key=\"gIndex\"\n        class=\"group\"\n        :style=\"{ gridTemplateColumns: `repeat(${group.length}, 1fr)` }\"\n    >\n      <div\n          v-for=\"(field, fIndex) in group\"\n          :key=\"field.id\"\n          class=\"field\"\n          draggable=\"true\"\n          @dragstart=\"onDragStart(field, gIndex)\"\n          @dragover.prevent=\"onDragOver($event, gIndex, fIndex)\"\n          @dragleave=\"onDragLeave\"\n          @drop.prevent=\"onDrop\"\n      >\n        {{ field.label }}\n        <div\n            v-if=\"hovered && hovered.groupIndex === gIndex && hovered.fieldIndex === fIndex\"\n            class=\"placeholder\"\n            :class=\"hovered.position\"\n        />\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref } from 'vue'\n\nconst groups = ref([\n  [{ id: 1, label: 'Наименование' }],\n  [{ id: 2, label: 'Количество' }],\n  [{ id: 3, label: 'Артикул' }],\n])\n\nconst dragged = ref(null)\nconst fromGroupIndex = ref(null)\n\nconst hovered = ref({\n  groupIndex: null,\n  fieldIndex: null,\n  position: null, // 'left' | 'right' | 'top' | 'bottom'\n})\n\nfunction onDragStart(field, groupIndex) {\n  dragged.value = field\n  fromGroupIndex.value = groupIndex\n}\n\nfunction onDragOver(event, groupIndex, fieldIndex) {\n  const rect = event.target.getBoundingClientRect()\n  const offsetX = event.clientX - rect.left\n  const offsetY = event.clientY - rect.top\n\n  let position = null\n  if (offsetY < rect.height / 3) position = 'top'\n  else if (offsetY > rect.height * 2 / 3) position = 'bottom'\n  else if (offsetX < rect.width / 2) position = 'left'\n  else position = 'right'\n\n  hovered.value = { groupIndex, fieldIndex, position }\n}\n\nfunction onDragLeave() {\n  hovered.value = { groupIndex: null, fieldIndex: null, position: null }\n}\n\nfunction onDrop() {\n  const { groupIndex, fieldIndex, position } = hovered.value\n  if (!dragged.value || groupIndex === null || fieldIndex === null) return\n\n  const field = dragged.value\n  const sourceGroup = groups.value[fromGroupIndex.value]\n  sourceGroup.splice(sourceGroup.findIndex(f => f.id === field.id), 1)\n\n  if (sourceGroup.length === 0) {\n    groups.value.splice(fromGroupIndex.value, 1)\n  }\n\n  if (position === 'left' || position === 'right') {\n    const targetGroup = groups.value[groupIndex]\n    const insertIndex = position === 'left' ? fieldIndex : fieldIndex + 1\n    targetGroup.splice(insertIndex, 0, field)\n  } else {\n    const newGroupIndex = position === 'top' ? groupIndex : groupIndex + 1\n    groups.value.splice(newGroupIndex, 0, [field])\n  }\n\n  // Reset\n  dragged.value = null\n  fromGroupIndex.value = null\n  hovered.value = { groupIndex: null, fieldIndex: null, position: null }\n}\n</script>\n\n<style scoped>\n.form-grid {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  padding: 24px;\n  background: #1e1e2f;\n}\n\n.group {\n  display: grid;\n  gap: 12px;\n}\n\n.field {\n  position: relative;\n  background: #2e2e2e;\n  padding: 16px;\n  color: #fff;\n  border: 1px solid #444;\n  border-radius: 4px;\n  cursor: grab;\n}\n\n.placeholder {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  width: 4px;\n  background-color: #00bcd4;\n}\n\n.placeholder.left {\n  left: 0;\n}\n\n.placeholder.right {\n  right: 0;\n}\n\n.placeholder.top,\n.placeholder.bottom {\n  height: 4px;\n  width: 100%;\n  left: 0;\n}\n\n.placeholder.top {\n  top: 0;\n}\n\n.placeholder.bottom {\n  bottom: 0;\n}\n</style>\n"],"mappings":"AA8BA,SAASA,GAAG,QAAQ,KAAI;;;;;;;IAExB,MAAMC,MAAM,GAAGD,GAAG,CAAC,CACjB,CAAC;MAAEE,EAAE,EAAE,CAAC;MAAEC,KAAK,EAAE;IAAe,CAAC,CAAC,EAClC,CAAC;MAAED,EAAE,EAAE,CAAC;MAAEC,KAAK,EAAE;IAAa,CAAC,CAAC,EAChC,CAAC;MAAED,EAAE,EAAE,CAAC;MAAEC,KAAK,EAAE;IAAU,CAAC,CAAC,CAC9B;IAED,MAAMC,OAAO,GAAGJ,GAAG,CAAC,IAAI;IACxB,MAAMK,cAAc,GAAGL,GAAG,CAAC,IAAI;IAE/B,MAAMM,OAAO,GAAGN,GAAG,CAAC;MAClBO,UAAU,EAAE,IAAI;MAChBC,UAAU,EAAE,IAAI;MAChBC,QAAQ,EAAE,IAAI,CAAE;IAClB,CAAC;IAED,SAASC,WAAWA,CAACC,KAAK,EAAEJ,UAAU,EAAE;MACtCH,OAAO,CAACQ,KAAK,GAAGD,KAAI;MACpBN,cAAc,CAACO,KAAK,GAAGL,UAAS;IAClC;IAEA,SAASM,UAAUA,CAACC,KAAK,EAAEP,UAAU,EAAEC,UAAU,EAAE;MACjD,MAAMO,IAAI,GAAGD,KAAK,CAACE,MAAM,CAACC,qBAAqB,CAAC;MAChD,MAAMC,OAAO,GAAGJ,KAAK,CAACK,OAAO,GAAGJ,IAAI,CAACK,IAAG;MACxC,MAAMC,OAAO,GAAGP,KAAK,CAACQ,OAAO,GAAGP,IAAI,CAACQ,GAAE;MAEvC,IAAId,QAAQ,GAAG,IAAG;MAClB,IAAIY,OAAO,GAAGN,IAAI,CAACS,MAAM,GAAG,CAAC,EAAEf,QAAQ,GAAG,KAAI,MACzC,IAAIY,OAAO,GAAGN,IAAI,CAACS,MAAM,GAAG,CAAC,GAAG,CAAC,EAAEf,QAAQ,GAAG,QAAO,MACrD,IAAIS,OAAO,GAAGH,IAAI,CAACU,KAAK,GAAG,CAAC,EAAEhB,QAAQ,GAAG,MAAK,MAC9CA,QAAQ,GAAG,OAAM;MAEtBH,OAAO,CAACM,KAAK,