ask/src/App.vue"],"sourcesContent":["<template>\n  <div class=\"form-grid\">\n    <div\n        v-for=\"(group, gIndex) in groups\"\n        :key=\"gIndex\"\n        class=\"group\"\n        :style=\"{ gridTemplateColumns: `repeat(${group.length}, 1fr)` }\"\n    >\n      <div\n          v-for=\"(field, fIndex) in group\"\n          :key=\"field.id\"\n          class=\"field\"\n          draggable=\"true\"\n          @dragstart=\"onDragStart(field, gIndex)\"\n          @dragover.prevent=\"onDragOver($event, field)\"\n          @dragleave=\"onDragLeave($event)\"\n          @drop=\"onDrop(field, gIndex)\"\n      >\n        {{ field.label }}\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref } from 'vue'\n\nconst groups = ref([\n  [{ id: 1, label: 'Наименование' }],\n  [{ id: 2, label: 'Количество' }],\n  [{ id: 3, label: 'Артикул' }],\n])\n\nconst dragged = ref(null)\nconst draggedGroupIndex = ref(null)\n\nfunction onDragStart(field, groupIndex) {\n  dragged.value = field\n  draggedGroupIndex.value = groupIndex\n}\n\nfunction onDragOver(event, field) {\n  event.target.classList.add('drag-over')\n}\n\nfunction onDragLeave(event) {\n  event.target.classList.remove('drag-over')\n}\n\nfunction onDrop(targetField, targetGroupIndex) {\n  const fromIndex = draggedGroupIndex.value\n  const toGroup = groups.value[targetGroupIndex]\n\n  if (dragged.value.id === targetField.id) return\n\n  // Удаляем из предыдущей группы\n  groups.value[fromIndex] = groups.value[fromIndex].filter(\n      (item) => item.id !== dragged.value.id\n  )\n\n  // Добавляем в целевую группу\n  toGroup.push(dragged.value)\n\n  // Удаляем пустые группы\n  groups.value = groups.value.filter(group => group.length > 0)\n\n  // Сброс временных значений\n  dragged.value = null\n  draggedGroupIndex.value = null\n\n  // Очистка классов\n  document.querySelectorAll('.drag-over').forEach(el => el.classList.remove('drag-over'))\n}\n</script>\n\n<style scoped>\n.form-grid {\n  display: fl