{"ast":null,"code":"import { ref } from 'vue';\nexport default {\n  __name: 'App',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const groups = ref([[{\n      id: 1,\n      label: 'Наименование'\n    }], [{\n      id: 2,\n      label: 'Количество'\n    }], [{\n      id: 3,\n      label: 'Артикул'\n    }]]);\n    const dragged = ref(null);\n    const fromGroupIndex = ref(null);\n    const hover = ref({\n      groupIndex: null,\n      fieldIndex: null,\n      zone: null\n    });\n    function onDragStart(field, gIndex) {\n      dragged.value = field;\n      fromGroupIndex.value = gIndex;\n    }\n    function onDragOverField(gIndex, fIndex, event) {\n      const rect = event.target.getBoundingClientRect();\n      const offsetX = event.clientX - rect.left;\n      const position = offsetX < rect.width / 2 ? 'left' : 'right';\n      hover.value = {\n        groupIndex: gIndex,\n        fieldIndex: fIndex,\n        zone: position\n      };\n    }\n    function onDropOnField(gIndex, fIndex) {\n      if (!dragged.value) return;\n      const sourceGroup = groups.value[fromGroupIndex.value];\n      const targetGroup = groups.value[gIndex];\n      sourceGroup.splice(sourceGroup.findIndex(f => f.id === dragged.value.id), 1);\n      if (sourceGroup.length === 0) groups.value.splice(fromGroupIndex.value, 1);\n      const insertIndex = hover.value.zone === 'left' ? fIndex : fIndex + 1;\n      targetGroup.splice(insertIndex, 0, dragged.value);\n      clearState();\n    }\n    function onDragOverZone(gIndex, zone) {\n      hover.value = {\n        groupIndex: gIndex,\n        fieldIndex: null,\n        zone\n      };\n    }\n    function onDropZone(gIndex, zone) {\n      if (!dragged.value) return;\n      const sourceGroup = groups.value[fromGroupIndex.value];\n      sourceGroup.splice(sourceGroup.findIndex(f => f.id === dragged.value.id), 1);\n      if (sourceGroup.length === 0) groups.value.splice(fromGroupIndex.value, 1);\n      const insertIndex = zone === 'top' ? gIndex : gIndex + 1;\n      groups.value.splice(insertIndex, 0, [dragged.value]);\n      clearState();\n    }\n    function getZoneClass(gIndex, zone) {\n      return hover.value.groupIndex === gIndex && hover.value.zone === zone ? 'hovered' : '';\n    }\n    function clearHover() {\n      hover.value = {\n        groupIndex: null,\n        fieldIndex: null,\n        zone: null\n      };\n    }\n    function clearState() {\n      dragged.value = null;\n      fromGroupIndex.value = null;\n      clearHover();\n    }\n    const __returned__ = {\n      groups,\n      dragged,\n      fromGroupIndex,\n      hover,\n      onDragStart,\n      onDragOverField,\n      onDropOnField,\n      onDragOverZone,\n      onDropZone,\n      getZoneClass,\n      clearHover,\n      clearState,\n      ref\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","groups","id","label","dragged","fromGroupIndex","hover","groupIndex","fieldIndex","zone","onDragStart","field","gIndex","value","onDragOverField","fIndex","event","rect","target","getBoundingClientRect","offsetX","clientX","left","position","width","onDropOnField","sourceGroup","targetGroup","splice","findIndex","f","length","insertIndex","clearState","onDragOverZone","onDropZone","getZoneClass","clearHover"],"sources":["/Users/avetikatabekyan/Desktop/new-test-task/src/App.vue"],"sourcesContent":["<template>\n  <div class=\"form-grid\">\n    <template v-for=\"(group, gIndex) in groups\" :key=\"gIndex\">\n      <div\n          class=\"drop-zone drop-top\"\n          @dragover.prevent=\"onDragOverZone(gIndex, 'top')\"\n          @dragleave=\"clearHover\"\n          @drop.prevent=\"onDropZone(gIndex, 'top')\"\n          :class=\"getZoneClass(gIndex, 'top')\"\n      ></div>\n\n      <div\n          class=\"group\"\n          :style=\"{ gridTemplateColumns: `repeat(${group.length}, 1fr)` }\"\n      >\n        <div\n            v-for=\"(field, fIndex) in group\"\n            :key=\"field.id\"\n            class=\"field\"\n            draggable=\"true\"\n            @dragstart=\"onDragStart(field, gIndex)\"\n            @dragover.prevent=\"onDragOverField(gIndex, fIndex, $event)\"\n            @dragleave=\"clearHover\"\n            @drop.prevent=\"onDropOnField(gIndex, fIndex)\"\n        >\n          {{ field.label }}\n        </div>\n      </div>\n    </template>\n\n    <div\n        class=\"drop-zone drop-bottom\"\n        @dragover.prevent=\"onDragOverZone(groups.length, 'bottom')\"\n        @dragleave=\"clearHover\"\n        @drop.prevent=\"onDropZone(groups.length, 'bottom')\"\n        :class=\"getZoneClass(groups.length, 'bottom')\"\n    ></div>\n  </div>\n</template>\n\n<script setup>\nimport { ref } from 'vue'\n\nconst groups = ref([\n  [{ id: 1, label: 'Наименование' }],\n  [{ id: 2, label: 'Количество' }],\n  [{ id: 3, label: 'Артикул' }],\n])\n\nconst dragged = ref(null)\nconst fromGroupIndex = ref(null)\nconst hover = ref({ groupIndex: null, fieldIndex: null, zone: null })\n\nfunction onDragStart(field, gIndex) {\n  dragged.value = field\n  fromGroupIndex.value = gIndex\n}\n\nfunction onDragOverField(gIndex, fIndex, event) {\n  const rect = event.target.getBoundingClientRect()\n  const offsetX = event.clientX - rect.left\n  const position = offsetX < rect.width / 2 ? 'left' : 'right'\n  hover.value = { groupIndex: gIndex, fieldIndex: fIndex, zone: position }\n}\n\nfunction onDropOnField(gIndex, fIndex) {\n  if (!dragged.value) return\n\n  const sourceGroup = groups.value[fromGroupIndex.value]\n  const targetGroup = groups.value[gIndex]\n  sourceGroup.splice(sourceGroup.findIndex(f => f.id === dragged.value.id), 1)\n  if (sourceGroup.length === 0) groups.value.splice(fromGroupIndex.value, 1)\n\n  const insertIndex = hover.value.zone === 'left' ? fIndex : fIndex + 1\n  targetGroup.splice(insertIndex, 0, dragged.value)\n\n  clearState()\n}\n\nfunction onDragOverZone(gIndex, zone) {\n  hover.value = { groupIndex: gIndex, fieldIndex: null, zone }\n}\n\nfunction onDropZone(gIndex, zone) {\n  if (!dragged.value) return\n\n  const sourceGroup = groups.value[fromGroupIndex.value]\n  sourceGroup.splice(sourceGroup.findIndex(f => f.id === dragged.value.id), 1)\n  if (sourceGroup.length === 0) groups.value.splice(fromGroupIndex.value, 1)\n\n  const insertIndex = zone === 'top' ? gIndex : gIndex + 1\n  groups.value.splice(insertIndex, 0, [dragged.value])\n\n  clearState()\n}\n\nfunction getZoneClass(gIndex, zone) {\n  return hover.value.groupIndex === gIndex && hover.value.zone === zone\n      ? 'hovered'\n      : ''\n}\n\nfunction clearHover() {\n  hover.value = { groupIndex: null, fieldIndex: null, zone: null }\n}\n\nfunction clearState() {\n  dragged.value = null\n  fromGroupIndex.value = null\n  clearHover()\n}\n</script>\n\n<style scoped>\n.form-grid {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  padding: 24px;\n  background: #1e1e2f;\n}\n\n.group {\n  display: grid;\n  gap: 12px;\n}\n\n.field {\n  background: #2e2e2e;\n  padding: 16px;\n  color: #fff;\n  border: 1px solid #444;\n  border-radius: 4px;\n  cursor: grab;\n  user-select: none;\n}\n\n.drop-zone {\n  height: 10px;\n  background-color: transparent;\n  transition: background-color 0.2s;\n}\n\n.drop-zone.hovered {\n  background-color: #00bcd4;\n}\n</style>\n"],"mappings":"AAyCA,SAASA,GAAG,QAAQ,KAAI;;;;;;;IAExB,MAAMC,MAAM,GAAGD,GAAG,CAAC,CACjB,CAAC;MAAEE,EAAE,EAAE,CAAC;MAAEC,KAAK,EAAE;IAAe,CAAC,CAAC,EAClC,CAAC;MAAED,EAAE,EAAE,CAAC;MAAEC,KAAK,EAAE;IAAa,CAAC,CAAC,EAChC,CAAC;MAAED,EAAE,EAAE,CAAC;MAAEC,KAAK,EAAE;IAAU,CAAC,CAAC,CAC9B;IAED,MAAMC,OAAO,GAAGJ,GAAG,CAAC,IAAI;IACxB,MAAMK,cAAc,GAAGL,GAAG,CAAC,IAAI;IAC/B,MAAMM,KAAK,GAAGN,GAAG,CAAC;MAAEO,UAAU,EAAE,IAAI;MAAEC,UAAU,EAAE,IAAI;MAAEC,IAAI,EAAE;IAAK,CAAC;IAEpE,SAASC,WAAWA,CAACC,KAAK,EAAEC,MAAM,EAAE;MAClCR,OAAO,CAACS,KAAK,GAAGF,KAAI;MACpBN,cAAc,CAACQ,KAAK,GAAGD,MAAK;IAC9B;IAEA,SAASE,eAAeA,C